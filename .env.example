# Bot Station settings. The easy way: ./setup.sh copies this to .env and
# fills in the three tokens. By hand: cp .env.example .env, set each token to
# the output of `openssl rand -hex 32`, then: docker compose up -d
# (Docker env files take no quotes and no comments after a value.)

# --- Required tokens (at least 32 characters each) ---
# Control API: turn the live view on/off, create viewer sessions. Keep it on
# your side; never give it to an agent.
CONTROL_TOKEN=
# Agent API: what the MCP server uses to drive the computer.
AGENT_TOKEN=
# MCP endpoint (http://127.0.0.1:8765/mcp): agents send it as
# "Authorization: Bearer <MCP_TOKEN>". Empty = no auth on the MCP port.
MCP_TOKEN=

# Optional, defaults shown. Uncomment to change.

# Allow viewers right after the container starts
#STREAM_ENABLED=false
#MAX_VIEWERS=2
# Seconds a viewer token stays valid (each works once)
#VIEWER_TOKEN_TTL=60
#STREAM_FPS=25
# JPEG quality when the screen is still / while a large area is moving
#STREAM_QUALITY=85
#STREAM_MOTION_QUALITY=45
# Clipboard sync for viewers that may control the desktop (never view-only):
# both, to-desktop (paste in only), from-desktop (copy out only) or off
#CLIPBOARD=both
# Comma-separated origins allowed to call the API, e.g. https://app.example.com
#ALLOWED_ORIGINS=*
# Origins allowed to embed /view in an iframe ('none' = nobody)
#FRAME_ANCESTORS='none'
# Public address used in view_url, e.g. https://desktop.example.com
#PUBLIC_URL=
# PEM certificate and key; without them a self-signed certificate is made
#TLS_CERT=
#TLS_KEY=
# Names in the self-signed certificate
#TLS_HOSTS=localhost,127.0.0.1

# --- Agent API (/agent/...: screenshots, input, windows, browser) ---
#AGENT_API=true
# Let agents run shell commands as root via POST /agent/exec
#AGENT_EXEC=false
# Let agents read and drive web pages (/agent/browser/...). Opens the
# browser's debugging port on 127.0.0.1 inside the container only.
#BROWSER_AUTOMATION=true
# Refresh rate the display reports (Hz). Browsers draw at this rate while
# something moves; above STREAM_FPS it only costs CPU.
#DISPLAY_HZ=25
# Agent mouse and keyboard at a person's pace: the pointer travels to a
# click on a curved path (cubic Bezier, sometimes S-shaped; now and then it
# overshoots a little and comes back) with a hand's speed profile, in
# ~0.25-0.5 s; keys come ~30 ms apart with some variation, wheel clicks
# 20-50 ms apart. Sites that watch for bots trust it more; false is
# instant (faster, for tests).
#AGENT_HUMAN_INPUT=true

# --- How the browser looks to websites ---
# Set these to match where the computer's IP is: a browser that says UTC
# from an Indian IP looks odd to bot detection.
# Timezone, e.g. Asia/Kolkata (also the desktop clock); unset = UTC
#TZ=
# Languages, most preferred first, e.g. en-IN,en,hi
#BROWSER_LANG=en-US,en
# WebGL in software. Almost every real browser has WebGL. No extra CPU
# for ordinary pages; ~40 MB RAM; a page animating WebGL nonstop costs
# ~25% of a core.
#BROWSER_WEBGL=true
# Send the browser's traffic through a fixed proxy, scheme://host:port
# (e.g. http://203.0.113.5:3128). Use it for an ISP/residential IP in the
# same region as TZ, from a provider whose terms allow it; sites often
# block datacenter IPs outright. No user:pass: let the proxy allow this
# computer's IP instead.
#BROWSER_PROXY=
# Helium's built-in ad blocker (uBlock Origin). Off saves ~115 MB on pages
# with few ads, but ad-heavy sites then cost more (measured on cnn.com:
# ~280 MB more RAM, ~30% of a core more CPU).
#BROWSER_ADBLOCK=false

# --- Compose: where it listens and resource limits (docker compose up) ---
# Address and port on the host. 127.0.0.1 = this machine only; 0.0.0.0 = all
# interfaces (put a firewall or your platform in front).
#BIND_ADDRESS=127.0.0.1
#PORT=8443
# Host port of the MCP server (http://127.0.0.1:8765/mcp)
#MCP_PORT=8765
# Host headers the MCP server accepts (DNS-rebinding protection). Add your
# hostname, e.g. bots.example.com:*, if agents reach it from elsewhere.
#MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
# CPU cores (fractions allowed) and RAM (no swap on top)
#CPU_LIMIT=2
#MEMORY_LIMIT=2g
# Max processes + threads
#PIDS_LIMIT=2048
# /dev/shm for the browser, and /tmp (both in RAM, inside MEMORY_LIMIT)
#SHM_SIZE=256m
#TMP_SIZE=512m
# Container log size (3 files kept)
#LOG_MAX_SIZE=10m
# Disk cap, only with compose.disk-limit.yaml on a host that supports it
#DISK_LIMIT=10G
